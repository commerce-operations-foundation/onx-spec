{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get-inventory",
  "description": "Input schema for querying inventory",
  "type": "object",
  "properties": {
    "skus": {
      "description": "Product SKU to get inventory for (required)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalIds": {
      "description": "External inventory ID from source system, could be a comma separated list",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locationIds": {
      "description": "Specific warehouse/location ID (optional - if not provided, returns aggregated inventory)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tenantIds": {
      "description": "Filter by tenant IDs",
      "type": "string"
    },
    "sort": {
      "description": "Field to sort by.",
      "type": "string",
      "enum": [ "createdAtAsc", "createdAtDesc", "updatedAtAsc", "updatedAtDesc" ]
    }
  },
  "required": [
    "skus"
  ],
  "additionalProperties": false
}
